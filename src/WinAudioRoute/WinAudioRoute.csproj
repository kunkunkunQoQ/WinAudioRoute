<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinAudioRoute 是 Windows-only SDK：不使用纯 net8.0 去伪装跨平台。
         显式带 TargetPlatformVersion，使平台分析器（CA1416）与 [SupportedOSPlatform] 生效，
         公共 API 的 Windows 限定可被编译期检查，而不仅写在文档里。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- 公开支持范围：Windows 10 2004（Build 19041）+ / Windows 11。
         与 SonicRoute 的公开声明保持一致（不允许 NuGet / README / 分析器出现三种口径）。 -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <RootNamespace>WinAudioRoute</RootNamespace>
    <AssemblyName>WinAudioRoute</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Phase 1：0.1.0。API 稳定前不发布 1.0（Semantic Versioning）。 -->
    <Version>0.1.0</Version>

    <!-- 所有公开 API 必须有 XML 文档。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- 平台限定：x64 为已验证的主要平台；ARM64 交叉编译受支持，但运行期为实验状态。
         不承诺 AnyCPU / x86 —— PROPVARIANT 的 24 字节布局是 x64/ARM64 假设（见 Interop/ComInterop.cs），
         运行期还有 PlatformGuard 显式拒绝 32 位进程。

         PlatformTarget 只在**不指定 RID** 时预置为 x64；带 -r win-x64 / -r win-arm64 时
         不设置该属性，由 SDK 依据 RID 推导（x64 / arm64）。否则全局 PlatformTarget=x64 会与
         win-arm64 的 RID 冲突（混合架构产物 / CS8012）。 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <!-- ==================== NuGet 包元数据 ==================== -->
  <PropertyGroup>
    <PackageId>WinAudioRoute</PackageId>
    <Authors>kunkunkunQoQ</Authors>
    <Company>kunkunkunQoQ</Company>
    <Product>WinAudioRoute</Product>
    <Description>Modern Windows audio control for .NET: enumerate audio devices, read and write application and device volume/mute, switch the system default device per role, route a single application's audio to a chosen device, and observe device/session change events.</Description>
    <PackageTags>windows;audio;wasapi;coreaudio;mmdevice;audio-session;volume;per-app-routing;sdk;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kunkunkunQoQ/WinAudioRoute</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kunkunkunQoQ/WinAudioRoute</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 自文档化：XML 文档随包发布（GenerateDocumentationFile 已开启） -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>false</DevelopmentDependency>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- 符号包：包含 PDB，便于消费者调试进入本库 -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- 可复现构建：同样的源产生逐位相同的产物 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- SourceLink：把 PDB 映射回 GitHub 源码。
       仅在存在 .git 工作树时启用。
       本仓库的源码是从 SonicRoute 提取后手工组织的；在 git init 之前没有可映射的提交，
       此时显式关闭 SourceLink，而不是生成指向错误提交的坏链接或发出噪音警告。
       注意：Exists() 的相对路径以**项目目录**为基准（不是 MSBuild 当前目录），
       因此这里用 $(MSBuildProjectDirectory) 显式构造。 -->
  <PropertyGroup>
    <GitWorkTreeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</GitWorkTreeRoot>
    <HasGitWorkTree Condition="Exists('$(GitWorkTreeRoot)\.git')">true</HasGitWorkTree>
    <HasGitWorkTree Condition="'$(HasGitWorkTree)' == ''">false</HasGitWorkTree>

    <!-- 显式双向设置：SourceLink 8.x 默认开启并会因缺少 git 信息而产生警告 -->
    <EnableSourceLink Condition="'$(HasGitWorkTree)' == 'true'">true</EnableSourceLink>
    <EnableSourceLink Condition="'$(HasGitWorkTree)' == 'false'">false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasGitWorkTree)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 包内 README（NuGet 要求显式包含） -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- 测试工程需要验证 internal 的互操作契约（布局、平台守护、纯逻辑）。 -->
    <InternalsVisibleTo Include="WinAudioRoute.Tests" />
  </ItemGroup>

</Project>
