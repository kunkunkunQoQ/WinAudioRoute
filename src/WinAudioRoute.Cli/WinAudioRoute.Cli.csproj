<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <RootNamespace>WinAudioRoute.Cli</RootNamespace>
    <AssemblyName>winaudio</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.1.0</Version>
    <Description>Command line interface for WinAudioRoute: Windows audio devices, sessions, per-app routing.</Description>
    <Product>WinAudioRoute</Product>

    <!-- 平台限定与库保持一致：x64 已验证 / ARM64 交叉编译支持、运行期实验 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>

    <!-- CLI 是不可打包工具，但需要 XML 文档以便自文档化 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinAudioRoute\WinAudioRoute.csproj" />
  </ItemGroup>

</Project>
